// This recipe takes your idea from napkin sketch to finished, merged code — designing, planning, building, and shipping it step by step.
digraph superpowers_full_development_cycle {
    rankdir=TB
    fontname="Helvetica"
    fontsize=12
    label="Full Development Cycle\nFrom idea to merged code — design, plan, build, and ship"
    labelloc=t
    labeljust=c
    compound=true
    nodesep=0.6
    ranksep=0.7
    bgcolor="white"
    source_hash="5728b33498a111f572e738eea1858588ef5c5eb4d62e2344697b74e7e156bd65"

    node [fontname="Helvetica", fontsize=11, style="filled,rounded"]
    edge [fontname="Helvetica", fontsize=9]

    start [label="Start", shape=oval, fillcolor="#e0e0e0"]
    done  [label="Done!", shape=oval, fillcolor="#e0e0e0"]

    subgraph cluster_design {
        label="Design\n\"What should we build?\""
        style="filled,rounded"
        fillcolor="#f9f9f9"
        color="#999999"

        step_setup_paths [label="Set Up File Names\nfor This Feature", shape=box, fillcolor="#bbdefb", style="filled,rounded", tooltip="DATE=$(date +%Y-%m-%d) FEATURE_SLUG=$(echo '{{feature_name}}' | tr ' ' '-' | tr '[:upper:]' '[:lower"]
        step_ensure_dirs [label="Create Working\nFolders", shape=box, fillcolor="#bbdefb", style="filled,rounded", tooltip="set -e mkdir -p '{{project_path}}/docs/plans' echo 'Created docs/plans directory' "]
        step_understand_context [label="Study the Project\n\"What exists already?\"", shape=box, fillcolor="#c8e6c9", style="filled,rounded", tooltip="superpowers:brainstormer"]
        step_explore_requirements [label="Ask Clarifying\nQuestions", shape=box, fillcolor="#c8e6c9", style="filled,rounded", tooltip="superpowers:brainstormer"]
        step_create_design [label="Draft the\nDesign Document", shape=box, fillcolor="#c8e6c9", style="filled,rounded", tooltip="superpowers:brainstormer"]
        step_save_design [label="Save the Design\nto Disk", shape=box, fillcolor="#bbdefb", style="filled,rounded", tooltip="cat > '{{project_path}}/{{paths.design_path}}' << 'DESIGN_EOF' {{design_content}} DESIGN_EOF echo 'S"]
        step_present_design [label="Summarize the\nDesign for Review", shape=box, fillcolor="#c8e6c9", style="filled,rounded", tooltip="superpowers:brainstormer"]

        start -> step_setup_paths
        step_setup_paths -> step_ensure_dirs
        step_ensure_dirs -> step_understand_context
        step_understand_context -> step_explore_requirements
        step_explore_requirements -> step_create_design
        step_create_design -> step_save_design
        step_save_design -> step_present_design
    }

    subgraph cluster_planning {
        label="Planning\n\"How do we build it?\""
        style="filled,rounded"
        fillcolor="#f9f9f9"
        color="#999999"

        step_load_design [label="Load the Saved\nDesign", shape=box, fillcolor="#bbdefb", style="filled,rounded", tooltip="cat '{{project_path}}/{{paths.design_path}}' "]
        step_create_plan [label="Break Design Into\nStep-by-Step Tasks", shape=box, fillcolor="#c8e6c9", style="filled,rounded", tooltip="superpowers:plan-writer"]
        step_save_plan [label="Save the Plan\nto Disk", shape=box, fillcolor="#bbdefb", style="filled,rounded", tooltip="cat > '{{project_path}}/{{paths.plan_path}}' << 'PLAN_EOF' {{plan_content}} PLAN_EOF echo 'Saved pla"]
        step_present_plan [label="Summarize the\nPlan for Review", shape=box, fillcolor="#c8e6c9", style="filled,rounded", tooltip="superpowers:plan-writer"]

        step_present_design -> step_load_design
        step_load_design -> step_create_plan
        step_create_plan -> step_save_plan
        step_save_plan -> step_present_plan
    }

    subgraph cluster_implementation {
        label="Implementation\n\"Let's build it!\""
        style="filled,rounded"
        fillcolor="#f9f9f9"
        color="#999999"

        step_create_worktree [label="Create a Safe\nWorkspace Branch", shape=box, fillcolor="#c8e6c9", style="filled,rounded", tooltip="foundation:git-ops"]
        step_load_plan [label="Load the Saved\nPlan", shape=box, fillcolor="#bbdefb", style="filled,rounded", tooltip="cat '{{project_path}}/{{paths.plan_path}}' "]
        step_execute_plan [label="Build the Feature\nTask by Task\n(subagent-driven-development)", shape=box, fillcolor="#e0e0e0", style="filled,rounded,dashed", tooltip="execute-plan"]
        step_check_for_errors [label="Check for\nErrors", shape=box, fillcolor="#bbdefb", style="filled,rounded", tooltip="if [ -n '{{implementation_result}}' ]; then   echo '{'has_error': false}' else   echo '{'has_error':"]
        cond_step_debug_if_needed [label="Errors found?", shape=diamond, fillcolor="#fff9c4"]
        step_debug_if_needed [label="Find and Fix\nthe Bugs", shape=box, fillcolor="#c8e6c9", style="filled,rounded", tooltip="foundation:bug-hunter"]
        step_verify_implementation [label="Verify Everything\nWorks Correctly", shape=box, fillcolor="#c8e6c9", style="filled,rounded", tooltip="superpowers:spec-reviewer"]
        step_present_implementation [label="Show What\nWas Built", shape=box, fillcolor="#bbdefb", style="filled,rounded", tooltip="cd '{{project_path}}/worktrees/{{paths.feature_slug}}' && \\ echo '=== Implementation Summary ===' &&"]

        step_present_plan -> step_create_worktree
        step_create_worktree -> step_load_plan
        step_load_plan -> step_execute_plan
        step_execute_plan -> step_check_for_errors
        step_check_for_errors -> cond_step_debug_if_needed
        cond_step_debug_if_needed -> step_debug_if_needed [label="Yes"]
        step_check_for_errors -> step_verify_implementation
        step_verify_implementation -> step_present_implementation
        cond_step_debug_if_needed -> step_verify_implementation [label="No", style=dashed]
    }

    subgraph cluster_finish {
        label="Finish\n\"Ship it!\""
        style="filled,rounded"
        fillcolor="#f9f9f9"
        color="#999999"

        step_determine_action [label="Decide: Pull Request\nor Direct Merge?", shape=box, fillcolor="#bbdefb", style="filled,rounded", tooltip="set -e ACTION='{{_approval_message}}' if [ -z '$ACTION' ]; then   ACTION='pr' fi echo '{\\'action\\': "]
        step_execute_finish [label="Publish the\nFinished Work", shape=box, fillcolor="#c8e6c9", style="filled,rounded", tooltip="foundation:git-ops"]
        step_final_summary [label="Show Final\nReport", shape=box, fillcolor="#bbdefb", style="filled,rounded", tooltip="echo '============================================' echo '  SUPERPOWERS DEVELOPMENT CYCLE COMPLETE' "]

        step_present_implementation -> step_determine_action
        step_determine_action -> step_execute_finish
        step_execute_finish -> step_final_summary
    }

    step_final_summary -> done

    subgraph cluster_legend {
        label="Legend"
        style="filled,rounded"
        fillcolor="white"
        color="#cccccc"
        fontsize=10
        node [shape=box, fontsize=9, width=1.6]
        leg_bash [label="Script Step", shape=box, fillcolor="#bbdefb"]
        leg_agent [label="AI Agent Step", shape=box, fillcolor="#c8e6c9"]
        leg_sub [label="Sub-Recipe Call", shape=box, fillcolor="#e0e0e0", style="filled,rounded,dashed"]
        leg_cond [label="Condition", shape=diamond, fillcolor="#fff9c4"]
        leg_start [label="Start / End", shape=oval, fillcolor="#e0e0e0"]
        leg_bash -> leg_agent -> leg_sub -> leg_cond -> leg_start [style=invis]
    }
}