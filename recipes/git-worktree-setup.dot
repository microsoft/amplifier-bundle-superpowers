digraph git_worktree_setup {
    rankdir=TB
    fontname="Helvetica"
    fontsize=12
    label="Git Worktree Setup — Create an isolated git worktree for feature development with automatic projec..."
    labelloc=t
    labeljust=c
    compound=true
    nodesep=0.6
    ranksep=0.7
    bgcolor="white"
    source_hash="7854d628557ccacc566c332fc919c085609f1a6166185a428714a39de7d96f71"

    node [fontname="Helvetica", fontsize=11, style="filled,rounded"]
    edge [fontname="Helvetica", fontsize=9]

    start [label="Start", shape=oval, fillcolor="#e0e0e0"]
    done  [label="Done!", shape=oval, fillcolor="#e0e0e0"]

    subgraph cluster_discovery {
        label="Discovery"
        style="filled,rounded"
        fillcolor="#f9f9f9"
        color="#999999"

        step_check_existing_dirs [label="Check Existing
Dirs", shape=box, fillcolor="#c8e6c9", style="filled,rounded", tooltip="foundation:git-ops"]
        step_determine_location [label="Determine
Location", shape=box, fillcolor="#c8e6c9", style="filled,rounded", tooltip="foundation:git-ops"]
        step_verify_gitignore [label="Verify
Gitignore", shape=box, fillcolor="#c8e6c9", style="filled,rounded", tooltip="foundation:git-ops"]

        start -> step_check_existing_dirs
        step_check_existing_dirs -> step_determine_location
        step_determine_location -> step_verify_gitignore
    }

    subgraph cluster_worktree_creation {
        label="Worktree Creation"
        style="filled,rounded"
        fillcolor="#f9f9f9"
        color="#999999"

        step_create_worktree [label="Create
Worktree", shape=box, fillcolor="#c8e6c9", style="filled,rounded", tooltip="foundation:git-ops"]

        step_verify_gitignore -> step_create_worktree
    }

    subgraph cluster_project_setup {
        label="Project Setup"
        style="filled,rounded"
        fillcolor="#f9f9f9"
        color="#999999"

        step_detect_project_type [label="Detect Project
Type", shape=box, fillcolor="#c8e6c9", style="filled,rounded", tooltip="superpowers:implementer"]
        step_run_setup [label="Run
Setup", shape=box, fillcolor="#c8e6c9", style="filled,rounded", tooltip="superpowers:implementer"]

        step_create_worktree -> step_detect_project_type
        step_detect_project_type -> step_run_setup
    }

    gate_baseline_verification [label="Human
Approves?", shape=diamond, fillcolor="#ffe0b2", tooltip="====================================================================== BASELINE TEST VERIFICATION - "]
    step_run_setup -> gate_baseline_verification
    subgraph cluster_baseline_verification {
        label="Baseline Verification"
        style="filled,rounded"
        fillcolor="#f9f9f9"
        color="#999999"

        step_run_baseline_tests [label="Run Baseline
Tests", shape=box, fillcolor="#c8e6c9", style="filled,rounded", tooltip="superpowers:implementer"]

        gate_baseline_verification -> step_run_baseline_tests
    }

    subgraph cluster_completion {
        label="Completion"
        style="filled,rounded"
        fillcolor="#f9f9f9"
        color="#999999"

        step_generate_report [label="Generate
Report", shape=box, fillcolor="#c8e6c9", style="filled,rounded", tooltip="foundation:git-ops"]

        step_run_baseline_tests -> step_generate_report
    }

    step_generate_report -> done

    subgraph cluster_legend {
        label="Legend"
        style="filled,rounded"
        fillcolor="white"
        color="#cccccc"
        fontsize=10
        node [shape=box, fontsize=9, width=1.6]
        leg_agent [label="AI Agent Step", shape=box, fillcolor="#c8e6c9"]
        leg_gate [label="Approval Gate", shape=diamond, fillcolor="#ffe0b2"]
        leg_start [label="Start / End", shape=oval, fillcolor="#e0e0e0"]
        leg_agent -> leg_gate -> leg_start [style=invis]
    }
}