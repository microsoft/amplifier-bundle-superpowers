digraph validate_implementation {
    rankdir=TB
    fontname="Helvetica"
    fontsize=12
    label="Validate Implementation — Validate externally-completed work against an implementation plan with single..."
    labelloc=t
    labeljust=c
    compound=true
    nodesep=0.6
    ranksep=0.7
    bgcolor="white"
    source_hash="cbd76ad3b6bced223be525833349ca44bf697e061a594a394039ab97a9162428"

    node [fontname="Helvetica", fontsize=11, style="filled,rounded"]
    edge [fontname="Helvetica", fontsize=9]

    start [label="Start", shape=oval, fillcolor="#e0e0e0"]
    done  [label="Done!", shape=oval, fillcolor="#e0e0e0"]

    subgraph cluster_validation {
        label="Validation"
        style="filled,rounded"
        fillcolor="#f9f9f9"
        color="#999999"

        step_load_plan [label="Load
Plan", shape=box, fillcolor="#c8e6c9", style="filled,rounded", tooltip="superpowers:plan-writer"]
        step_per_task_validation [label="Per Task
Validation
(for each)", shape=box, fillcolor="#c8e6c9", style="filled,rounded", tooltip="per-task-validation"]
        step_validation_summary [label="Validation
Summary", shape=box, fillcolor="#c8e6c9", style="filled,rounded", tooltip="superpowers:plan-writer"]

        start -> step_load_plan
        step_load_plan -> step_per_task_validation
        step_per_task_validation -> step_validation_summary
    }

    gate_review [label="Human
Approves?", shape=diamond, fillcolor="#ffe0b2", tooltip="====================================================================== VALIDATION COMPLETE — HUMAN R"]
    step_validation_summary -> gate_review
    subgraph cluster_review {
        label="Review"
        style="filled,rounded"
        fillcolor="#f9f9f9"
        color="#999999"

        step_present_results [label="Present
Results", shape=box, fillcolor="#c8e6c9", style="filled,rounded", tooltip="superpowers:plan-writer"]

        gate_review -> step_present_results
    }

    step_present_results -> done

    subgraph cluster_legend {
        label="Legend"
        style="filled,rounded"
        fillcolor="white"
        color="#cccccc"
        fontsize=10
        node [shape=box, fontsize=9, width=1.6]
        leg_agent [label="AI Agent Step", shape=box, fillcolor="#c8e6c9"]
        leg_gate [label="Approval Gate", shape=diamond, fillcolor="#ffe0b2"]
        leg_start [label="Start / End", shape=oval, fillcolor="#e0e0e0"]
        leg_agent -> leg_gate -> leg_start [style=invis]
    }
}